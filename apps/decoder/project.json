{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "decoder",
  "projectType": "application",
  "sourceRoot": "apps/decoder/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build --workspace=decoder"
      },
      "outputs": ["{workspaceRoot}/dist/decoder"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev --workspace=decoder"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run preview --workspace=decoder"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run storybook --workspace=decoder"
      }
    }
  }
}