{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "config-lens",
  "projectType": "application",
  "sourceRoot": "apps/config-lens/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build --workspace=config-lens"
      },
      "outputs": ["{workspaceRoot}/dist/config-lens"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev --workspace=config-lens"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run lint --workspace=config-lens"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run preview --workspace=config-lens"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run storybook --workspace=config-lens"
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test:e2e --workspace=config-lens"
      }
    }
  }
}
