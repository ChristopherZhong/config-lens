    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@tools/breadcrumb": "1.0.0",
    "@tools/theme-toggle": "*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "codemirror": "^6.0.2",
    "js-yaml": "^5.5.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@lezer/common": "^1.5.5",
    "@playwright/test": "^1.65.0",
    "@storybook/web-components": "^10.6.6",
