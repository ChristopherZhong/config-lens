{
  "name": "config-lens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit",
    "build": "tsc && vite build && npm run build-storybook",
    "preview": "vite preview",
    "test:watch": "vitest",
