{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "calculator",
  "projectType": "application",
  "sourceRoot": "apps/calculator/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build --workspace=calculator"
      },
      "outputs": ["{workspaceRoot}/dist/calculator"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev --workspace=calculator"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run preview --workspace=calculator"
      }
    }
  }
}
