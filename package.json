{
  "name": "tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2 || ^26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build && npm run build:catalog",
    "build:catalog": "cp index.html dist/index.html",
    "dev": "nx run config-lens:dev",
    "lint": "tsc -p tsconfig.json && nx run-many -t lint",
    "preview": "nx run config-lens:preview",
    "storybook": "nx run config-lens:storybook",
    "test": "nx run-many -t test",
    "test:e2e": "nx run config-lens:test:e2e",
    "test:watch": "nx run config-lens:test:watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@nx/eslint": "24.0.5",
    "@nx/vitest": "^24.0.5",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^26.6.6",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nx": "^24.0.5",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
