{
  "name": "tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2 || ^26.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build && npm run build:catalog",
    "build:catalog": "cp index.html dist/index.html",
    "dev": "nx run config-lens:dev",
    "lint": "tsc -p tsconfig.json && nx run-many -t lint",
    "preview": "nx run config-lens:preview",
    "storybook": "nx run config-lens:storybook",
    "test": "nx run-many -t test",
    "test:e2e": "nx run config-lens:test:e2e",
    "test:watch": "nx run config-lens:test:watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "nx": "^24.0.3"
  }
}
